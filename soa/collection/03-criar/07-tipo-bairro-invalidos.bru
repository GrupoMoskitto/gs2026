meta {
  name: POST tipo e bairro inválidos → 400
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/relatos
  body: json
  auth: none
}

body:json {
  {
    "tipo": "carro",
    "descricao": "Levaram meu celular no ponto de ônibus",
    "latitude": -23.561,
    "longitude": -46.656,
    "bairro": "copacabana",
    "ocorrido_em": "{{$isoTimestamp}}",
    "origem": "mobile"
  }
}

tests {
  test("responde 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
  test("explica o erro", function () {
    expect(res.getBody().erro).to.be.a("string");
  });
}
