meta {
  name: POST relato válido → 201
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/relatos
  body: json
  auth: none
}

headers {
  Idempotency-Key: {{$randomUUID}}
}

body:json {
  {
    "tipo": "celular",
    "descricao": "Levaram meu celular no ponto de ônibus",
    "latitude": -23.561,
    "longitude": -46.656,
    "bairro": "bela_vista",
    "ocorrido_em": "{{$isoTimestamp}}",
    "origem": "mobile"
  }
}

script:post-response {
  if (res.getStatus() === 201) bru.setVar("relato_id", res.getBody().id);
}

tests {
  test("responde 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("relato novo é pendente", function () {
    expect(res.getBody().status).to.equal("pendente");
  });
}

docs {
  Cria o relato, sempre `pendente`, com o cabeçalho `Location`. Guarda o id em `relato_id` para as requisições de moderação.
}
