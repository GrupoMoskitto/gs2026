meta {
  name: POST com chave fixa → 201
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/relatos
  body: json
  auth: none
}

headers {
  Idempotency-Key: bruno-demo-{{chave_demo}}
}

body:json {
  {
    "tipo": "celular",
    "descricao": "Levaram meu celular no ponto de ônibus",
    "latitude": -23.561,
    "longitude": -46.656,
    "bairro": "bela_vista",
    "ocorrido_em": "{{$isoTimestamp}}",
    "origem": "mobile"
  }
}

script:pre-request {
  bru.setVar("chave_demo", Date.now());
}

tests {
  test("responde 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  Primeiro envio com uma chave nova. A próxima requisição repete a mesma chave.
}
