meta {
  name: POST data antiga → 400
  type: http
  seq: 8
}

post {
  url: {{base_url}}/api/relatos
  body: json
  auth: none
}

body:json {
  {
    "tipo": "celular",
    "descricao": "Levaram meu celular no ponto de ônibus",
    "latitude": -23.561,
    "longitude": -46.656,
    "bairro": "bela_vista",
    "ocorrido_em": "2025-01-01T10:00:00-03:00",
    "origem": "mobile"
  }
}

tests {
  test("responde 400", function () {
    expect(res.getStatus()).to.equal(400);
  });
  test("explica o erro", function () {
    expect(res.getBody().erro).to.be.a("string");
  });
}

docs {
  `ocorrido_em` precisa estar nos últimos 30 dias e não no futuro.
}
