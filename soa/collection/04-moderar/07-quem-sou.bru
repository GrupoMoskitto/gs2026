get {
  url: {{base_url}}/api/moderadores/eu
  body: none
  auth: bearer
}

auth:bearer {
  token: {{chave_moderador}}
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("diz o apelido do moderador", function () {
    expect(res.getBody().apelido).to.be.a("string");
  });
}

