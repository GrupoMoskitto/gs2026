meta {
  name: PATCH rejeitar com motivo → 200
  type: http
  seq: 2
}

patch {
  url: {{base_url}}/api/relatos/{{relato_id}}/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{chave_moderador}}
}

body:json {
  {
    "status": "rejeitado",
    "motivo": "relato duplicado"
  }
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
