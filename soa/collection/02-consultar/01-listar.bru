meta {
  name: GET relatos → 200
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/relatos
  body: none
  auth: none
}

tests {
  test("responde 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("traz o total no X-Total-Count", function () {
    expect(res.getHeader("x-total-count")).to.not.be.undefined;
  });
}

docs {
  Os 200 relatos mais recentes. O total sem o limite vem no cabeçalho `X-Total-Count`.
}
