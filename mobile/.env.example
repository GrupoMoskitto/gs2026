# Copie para .env (não vai para o git) e ajuste.
# No celular, "localhost" é o próprio celular: use o IP do computador na mesma rede Wi-Fi.
# Sem esta variável o app roda com dados de exemplo e avisa isso na tela.
EXPO_PUBLIC_API_URL=http://192.168.0.10:5000

# Só para gravar o vídeo de apresentação: com 1, esconde a faixa "Dados de exemplo" (o resto do app não muda).
# EXPO_PUBLIC_MODO_VIDEO=1
